# Build the directive reference shown in argparse help. This function only
# formats static metadata; it does not inspect or modify Nagios configuration.
# Keeping the help text generated from OBJECT_DIRECTIVES avoids maintaining a
# separate, potentially stale list of accepted directives.
def format_object_directives(resource: str) -> str:
    """Render documented Nagios directives for argparse help."""
    if resource == "template":
        return (
            "Templates use the directives of their --object-type plus the common "
            "name/use/register directives. Run 'nagios-cmd help host', "
            "'nagios-cmd help service', or 'nagios-cmd help contact'."
        )
    directives = OBJECT_DIRECTIVES.get(resource, [])
    rows = ["Nagios object directives:", "  PROPERTY                      REQUIRED  VALUE"]
    for key, value, required in [*COMMON_DIRECTIVES, *directives]:
        rows.append(f"  {key:<29} {'yes' if required else 'no':<8}  {value}")
    rows.extend([
        "",
        "Required directives may be inherited with 'use'.",
        "Pass additional directives with -o key=value.",
    ])
    return "\n".join(rows)


