# Determine the Nagios configuration root used by all later path calculations.
# Priority is explicit NAGIOS_BASE, then /etc/nagios when present, otherwise
# /etc/nagios4 for the Ubuntu/Debian packaging convention used by this role.
def detect_base() -> Path:
    """Detect the Nagios configuration base directory."""
    env_value = os.environ.get("NAGIOS_BASE")
    if env_value:
        return Path(env_value)
    if Path("/etc/nagios").exists():
        return Path("/etc/nagios")
    return Path("/etc/nagios4")


