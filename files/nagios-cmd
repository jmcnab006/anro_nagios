# Marker exception for expected operational failures that should be reported cleanly
# by main() rather than displayed as Python tracebacks.
class NagiosCmdError(Exception):
    """Operational error that should be printed without a Python traceback."""


@dataclass
# Structured representation of one parsed Nagios object. In addition to directives,
# source path and byte/character offsets are retained so edits can target exactly the
# matching block without rewriting unrelated configuration.
class NagiosObject:
    """Parsed representation of one Nagios object block."""
    object_type: str
    fields: Dict[str, str]
    path: Path
    start: int
    end: int
    raw: str


# Central user-facing failure helper. Operational validation failures use this
# path so callers get a concise ERROR message and a predictable non-zero exit
# without an implementation traceback.
def die(message: str, code: int = 1) -> None:
    """Print a user-facing error message and exit."""
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(code)


# Validate names before they are used as object identifiers or path components.
# The restricted character set and explicit slash rejection protect the managed
# configuration tree from path traversal and accidental nested path creation.
def safe_name(value: str, label: str = "name") -> str:
    """Validate a filesystem-safe object name and return it."""
    if not value:
        die(f"{label} cannot be empty")
    if "/" in value or value in {".", ".."} or not SAFE_NAME_RE.match(value):
        die(
            f"invalid {label}: {value!r}; allowed characters are letters, "
            "numbers, dot, underscore, dash, and colon"
        )
    return value


# Convert repeated -o/--options values into Nagios directive key/value pairs.
# A single option argument may contain comma-separated assignments. Later values
# replace earlier ones for the same key, matching normal command-line override
# expectations.
def parse_options(values: Optional[List[str]]) -> Dict[str, str]:
    """Parse repeated -o/--options values into a directive dictionary."""
    options: Dict[str, str] = {}
    if not values:
        return options
    for raw_value in values:
        for raw_part in raw_value.split(","):
            part = raw_part.strip()
            if not part:
                continue
            if "=" not in part:
                die(f"invalid option {part!r}; expected key=value")
            key, value = part.split("=", 1)
            key = key.strip()
            value = value.strip()
            if not key:
                die(f"invalid option {part!r}; key cannot be empty")
            options[key] = value
    return options


# Parse -v/--variable NAME=VALUE arguments used by service templates.
# Template variables are intentionally separate from Nagios directives because
# they are substitutions performed before the rendered service block is parsed.
def parse_variables(values: Optional[List[str]]) -> Dict[str, str]:
    """Parse repeated -v/--variable template substitutions."""
    variables: Dict[str, str] = {}

    if not values:
        return variables

    for raw_value in values:
        if "=" not in raw_value:
            die(f"invalid variable {raw_value!r}; expected key=value")

        key, value = raw_value.split("=", 1)
        key = key.strip()
        value = value.strip()

        if not key:
            die(f"invalid variable {raw_value!r}; variable name cannot be empty")

        variables[key] = value

    return variables


# Detect unresolved {{ variable }} placeholders after template substitution.
# Refusing to write partially rendered service definitions prevents invalid or
# unexpectedly literal template placeholders from reaching Nagios.
def validate_template_variables(content: str) -> None:
    """Reject service definitions containing unresolved template variables."""
    unresolved = sorted(
        set(
            re.findall(
                r"{{\s*([A-Za-z_][A-Za-z0-9_]*)\s*}}",
                content,
            )
        )
    )

    if unresolved:
        die(
            "missing service template variable(s): "
            + ", ".join(unresolved)
        )


# Apply caller-supplied service-template substitutions. re.escape protects the
# variable name in the generated regular expression, while the replacement is
# supplied through a lambda so backslashes in values are treated literally.
def render_template_variables(
        content: str,
        variables: Dict[str, str],
) -> str:
    """Replace {{ variable }} placeholders with supplied values."""
    for key, value in variables.items():
        pattern = r"{{\s*" + re.escape(key) + r"\s*}}"
        content = re.sub(pattern, lambda _match, replacement=value: replacement, content)

    return content


# Expand the human-oriented directive metadata into the exact names accepted by
# -o/--options validation. Documentation shorthand such as address1..address6
# and aliases is normalized here so validation logic stays centralized.
def valid_directive_names(resource: str) -> set[str]:
    """Return valid directive names for one Nagios object type."""
    directives = COMMON_DIRECTIVES + OBJECT_DIRECTIVES.get(resource, [])

    names: set[str] = set()

    for name, _value_hint, _required in directives:
        # Documentation entries such as "obsess_over_host / obsess" represent
        # multiple accepted directive names.
        if " / " in name:
            names.update(part.strip() for part in name.split(" / "))
            continue

        # Expand documented shorthand used by the help table.
        if name == "address1..address6":
            names.update(f"address{index}" for index in range(1, 7))
            continue

        if name == "sunday..saturday":
            names.update(
                {
                    "sunday",
                    "monday",
                    "tuesday",
                    "wednesday",
                    "thursday",
                    "friday",
                    "saturday",
                }
            )
            continue

        # [exception] is documentation notation, not a literal directive.
        if name == "[exception]":
            continue

        names.add(name)

    return names


# Validate arbitrary -o/--options keys before any file is written. Unknown
# directives are rejected early and a close-match hint is provided when useful;
# this prevents simple typos from creating silently ignored Nagios directives.
def validate_options(resource: str, options: Dict[str, str]) -> None:
    """Reject unknown Nagios directives before writing configuration."""
    valid_directives = valid_directive_names(resource)

    if not valid_directives:
        die(f"no directive metadata defined for resource: {resource}")

    for key in options:
        if key in valid_directives:
            continue

        suggestion = difflib.get_close_matches(
            key,
            sorted(valid_directives),
            n=1,
            cutoff=0.6,
        )

        message = f"invalid {resource} directive: {key!r}"

        if suggestion:
            message += f"; did you mean {suggestion[0]!r}?"

        die(message)


# Gate destructive or overwrite operations behind an interactive confirmation.
# --force bypasses the prompt for automation and preserves the existing CLI
# contract used by Ansible or other non-interactive callers.
def confirm(prompt: str, force: bool = False) -> None:
    """Confirm destructive or overwrite operations unless force is set."""
    if force:
        return
    answer = input(f"{prompt} [y/N]: ").strip().lower()
    if answer not in {"y", "yes"}:
        die("aborted")


# Resolve the configured Nagios service account to numeric UID/GID values.
# Numeric IDs are used for atomic file creation and metadata enforcement so the
# resulting files remain readable by Nagios and consistently owned.
def managed_identity() -> Tuple[int, int]:
    """Resolve the configured Nagios user/group IDs."""
    try:
        uid = pwd.getpwnam(NAGIOS_USER).pw_uid
        gid = grp.getgrnam(NAGIOS_GROUP).gr_gid
    except KeyError as exc:
        raise NagiosCmdError(f"Nagios account not found: {exc}") from exc
    return uid, gid


# Enforce ownership and mode on a managed file or directory. Root can correct
# both owner and group; an existing Nagios-owned file may correct only its group.
# Other ownership mismatches fail rather than weakening the permission policy.
def apply_managed_metadata(path: Path, mode: int) -> None:
    """Apply the shared nagios-cmd ownership and permission policy."""
    uid, gid = managed_identity()
    current = path.stat()
    if current.st_uid != uid or current.st_gid != gid:
        if os.geteuid() == 0:
            os.chown(path, uid, gid)
        elif current.st_uid == uid:
            try:
                os.chown(path, -1, gid)
            except PermissionError as exc:
                raise PermissionError(
                    f"{path} must use group {NAGIOS_GROUP}; run nagios-cmd as root "
                    "or ensure the Nagios account can set that group"
                ) from exc
        else:
            raise PermissionError(
                f"{path} must be owned by {NAGIOS_USER}:{NAGIOS_GROUP}; "
                "run nagios-cmd as root or the Nagios service account"
            )
    os.chmod(path, mode)


# Create a managed directory recursively and immediately normalize its ownership
# and permissions. This makes later file operations independent of the invoking
# process umask.
def ensure_directory(path: Path) -> None:
    """Create one managed custom directory with consistent metadata."""
    path.mkdir(parents=True, exist_ok=True)
    apply_managed_metadata(path, MANAGED_DIRECTORY_MODE)


# Write raw content through a temporary file in the destination directory, set
# the requested metadata, then replace the target atomically. This prevents a
# reader such as Nagios from observing a partially written configuration file.
def write_raw_atomic(path: Path, content: str, mode: int, uid: int, gid: int) -> None:
    """Atomically replace a file with explicit metadata and no validation."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
            "w", encoding="utf-8", dir=str(path.parent), delete=False
    ) as tmp:
        tmp_path = Path(tmp.name)
        tmp.write(content)
    try:
        if os.geteuid() == 0:
            os.chown(tmp_path, uid, gid)
        else:
            current = tmp_path.stat()
            if current.st_uid != uid:
                raise PermissionError(
                    f"cannot set ownership on {tmp_path}; run nagios-cmd as root "
                    "or the Nagios service account"
                )
            if current.st_gid != gid:
                try:
                    os.chown(tmp_path, -1, gid)
                except PermissionError as exc:
                    raise PermissionError(
                        f"cannot set group {NAGIOS_GROUP} on {tmp_path}"
                    ) from exc
        os.chmod(tmp_path, mode)
        os.replace(tmp_path, path)
    finally:
        tmp_path.unlink(missing_ok=True)


# Ensure every administrator-managed configuration directory exists before an
# operation attempts to read or write custom objects. Aggregate Ansible-owned
# files are intentionally not created or modified here.
def ensure_layout() -> None:
    """Create the administrator-managed configuration skeleton if missing."""
    paths = [*CUSTOM_ROOTS, HOSTS_DIR / DEFAULT_HOSTGROUP, SERVICEDEFS_DIR, BACKUP_DIR]
    for path in dict.fromkeys(paths):
        ensure_directory(path)


# Read UTF-8 configuration text from disk. Centralizing this tiny operation keeps
# file decoding behavior consistent throughout object discovery and editing.
def read_text(path: Path) -> str:
    """Read a UTF-8 file or exit cleanly if it is missing."""
    try:
        return path.read_text(encoding="utf-8")
    except FileNotFoundError:
        die(f"file not found: {path}")


# Execute an external command without a shell and capture combined output.
# Avoiding shell=True prevents interpolation surprises and keeps arguments passed
# to Nagios/systemctl exactly as constructed by the caller.
def run_command(command: List[str]) -> subprocess.CompletedProcess:
    """Run a command and capture combined stdout/stderr."""
    return subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)


# Run the Nagios executable in verification mode against the configured main
# nagios.cfg. The return code is propagated to callers so mutations can refuse to
# report success when the complete configuration does not validate.
def validate_config() -> None:
    """Validate Nagios configuration with nagios4 -v."""
    if not Path(NAGIOS_BIN).exists():
        raise NagiosCmdError(f"Nagios binary not found: {NAGIOS_BIN}")
    if not NAGIOS_CFG.exists():
        raise NagiosCmdError(f"Nagios config not found: {NAGIOS_CFG}")
    result = run_command([NAGIOS_BIN, "-v", str(NAGIOS_CFG)])
    if result.returncode != 0:
        raise NagiosCmdError(result.stdout.rstrip())


# Atomically write a managed configuration file using the standard Nagios owner,
# group, and file mode. This higher-level wrapper applies the common metadata
# policy used by all normal object-writing operations.
def write_text_atomic(
        path: Path, content: str, force: bool = False
) -> None:
    """Atomically write a custom file without validating or reloading Nagios."""
    if path.exists():
        confirm(f"Overwrite {path}?", force=force)
    ensure_directory(path.parent)
    old_stat = path.stat() if path.exists() else None
    uid, gid = managed_identity()
    if (
            old_stat is not None
            and os.geteuid() != 0
            and (old_stat.st_uid != uid or old_stat.st_gid != gid)
    ):
        raise PermissionError(
            f"cannot safely replace {path} while preserving rollback metadata; "
            "run nagios-cmd as root"
        )
    write_raw_atomic(path, content, MANAGED_FILE_MODE, uid, gid)


# Render one Nagios object definition from an object type and ordered field map.
# Output is deliberately simple and deterministic so subsequent parsing/editing
# can operate on the generated files predictably.
def object_block(object_type: str, fields: Dict[str, str]) -> str:
    """Render one Nagios object definition from ordered key/value fields."""
    lines = [f"define {object_type} {{"]
    for key, value in fields.items():
        lines.append(f"    {key:<28} {value}")
    lines.append("}")
    return "\n".join(lines) + "\n"


# Parse Nagios define {...} blocks from one configuration file into structured
# NagiosObject records while retaining source offsets and raw text. Offsets allow
# later updates/removals to replace only the selected block in multi-object files.
def parse_objects_from_text(text: str, path: Path) -> List[NagiosObject]:
    """Parse typical Nagios define-object blocks from text."""
    objects: List[NagiosObject] = []
    pattern = re.compile(r"define\s+([A-Za-z0-9_]+)\s*\{(.*?)\}", re.DOTALL)
    for match in pattern.finditer(text):
        fields: Dict[str, str] = {}
        for raw_line in match.group(2).splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            if ";" in line:
                line = line.split(";", 1)[0].rstrip()
            parts = line.split(None, 1)
            if len(parts) == 2:
                fields[parts[0]] = parts[1].strip()
        objects.append(NagiosObject(match.group(1), fields, path, match.start(), match.end(), match.group(0)))
    return objects


# Yield configuration files relevant to a resource from both administrator-owned
# custom directories and the role/package default aggregate files. Discovery is
# read-only and intentionally spans both ownership domains.
def iter_cfg_files() -> Iterable[Path]:
    """Yield all .cfg files under the objects directory."""
    if not OBJECTS_DIR.exists():
        return []
    return sorted(OBJECTS_DIR.rglob("*.cfg"))


# Iterate parsed objects of the requested resource type across all discovered
# configuration files. Template handling is special because templates may use
# several Nagios object types while being identified by the common name field.
def iter_objects(resource: Optional[str] = None) -> Iterable[NagiosObject]:
    """Yield parsed objects, optionally filtered by nagios-cmd resource."""
    for path in iter_cfg_files():
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, FileNotFoundError):
            continue
        for obj in parse_objects_from_text(text, path):
            if resource is None:
                yield obj
            elif resource == "template":
                if "name" in obj.fields and obj.fields.get("register") == "0":
                    yield obj
            elif obj.object_type == RESOURCE_META[resource]["object_type"]:
                yield obj


# Return the canonical lookup name for a parsed object according to RESOURCE_META.
# Keeping this mapping centralized lets generic commands work uniformly across
# hosts, groups, contacts, commands, templates, and time periods.
def object_name(resource: str, obj: NagiosObject) -> Optional[str]:
    """Return the logical display name for a parsed object."""
    if resource == "service":
        host_name = obj.fields.get("host_name", "")
        service_description = obj.fields.get("service_description", "")
        return f"{host_name}/{service_description}" if host_name and service_description else service_description or None
    return obj.fields.get(RESOURCE_META[resource]["name_key"])


# Locate one object by its resource-specific key, with service lookups additionally
# scoped by hostname and service description. The first exact match is returned;
# callers treat None as a normal not-found condition.
def find_object(resource: str, name: str, second: Optional[str] = None) -> Optional[NagiosObject]:
    """Find an object by logical name; service uses host_name + service_description."""
    if resource == "service":
        for obj in iter_objects("service"):
            if obj.fields.get("host_name") == name and obj.fields.get("service_description") == second:
                return obj
        return None
    name_key = RESOURCE_META[resource]["name_key"]
    for obj in iter_objects(resource):
        if obj.fields.get(name_key) == name:
            return obj
    return None


# Return the aggregate/default files owned outside nagios-cmd for a resource.
# These files are discoverable and readable but must not be modified by the custom
# configuration manager.
def default_owned_files() -> set[Path]:
    """Return files known to be Ansible/default-owned and read-only to this tool."""
    files: set[Path] = set()
    for meta in RESOURCE_META.values():
        for path in meta["default_files"]:
            if path.exists():
                files.add(path.resolve())
    return files


# Test whether a path is contained by a managed root after resolving both paths.
# This ownership-boundary check prevents writes/removals from escaping the custom
# configuration directories through relative paths or symlinks.
def path_is_within(path: Path, root: Path) -> bool:
    """Return True when a resolved path is inside a resolved directory root."""
    try:
        path.resolve().relative_to(root.resolve())
        return True
    except ValueError:
        return False


# Determine whether an existing object resides in a nagios-cmd managed location.
# Generic set/remove operations use this to refuse modification of Ansible-owned
# or package-owned aggregate configuration.
def object_is_custom(obj: NagiosObject) -> bool:
    """Return True only for objects below explicitly administrator-owned roots."""
    path = obj.path.resolve()
    if path in default_owned_files():
        return False
    return any(path_is_within(path, root) for root in CUSTOM_ROOTS)


# Calculate the canonical destination path for a newly managed object. Hosts and
# services use the hostgroup/host directory layout; other resources use their
# dedicated custom resource directory.
def custom_object_path(resource: str, name: str, hostgroup: Optional[str] = None) -> Path:
    """Calculate the target custom file path for a resource object."""
    safe_name(name, resource)
    if resource == "host":
        group = safe_name(hostgroup or DEFAULT_HOSTGROUP, "hostgroup")
        return HOSTS_DIR / group / f"{name}.cfg"
    if resource == "hostgroup":
        return HOSTS_DIR / safe_name(name, "hostgroup") / "hostgroup.cfg"
    return RESOURCE_META[resource]["custom_dir"] / f"{name}.cfg"


# Ensure the directory/file scaffolding required for a custom hostgroup exists.
# This preserves the established hostgroup-based layout while avoiding changes to
# aggregate hostgroup configuration managed elsewhere.
def ensure_hostgroup_file(hostgroup: str, force: bool = True) -> Path:
    """Ensure a hostgroup directory and hostgroup.cfg exist."""
    hostgroup = safe_name(hostgroup, "hostgroup")
    target = custom_object_path("hostgroup", hostgroup)
    if not target.exists():
        fields = {"hostgroup_name": hostgroup, "alias": hostgroup}
        write_text_atomic(target, object_block("hostgroup", fields), force=force)
    return target


# Build the Nagios directive map for a generic add operation from positional CLI
# arguments plus validated -o options. Resource-specific defaults and fields are
# assembled here so the write path can remain generic.
def fields_for_add(resource: str, args: argparse.Namespace) -> Dict[str, str]:
    """Build initial Nagios fields for an add command and merge -o options."""
    options = parse_options(args.options)
    validation_resource = resource

    if resource == "template":
        validation_resource = args.object_type

    validate_options(validation_resource, options)

    if resource == "host":
        fields = {
            "use": options.pop("use", "generic-host"),
            "host_name": args.name,
            "alias": options.pop("alias", args.name),
            "address": args.address,
            "hostgroups": args.hostgroup or DEFAULT_HOSTGROUP,
        }

    elif resource == "contact":
        fields = {
            "use": options.pop("use", "generic-contact"),
            "contact_name": args.name,
            "alias": options.pop("alias", args.name),
        }

    elif resource == "template":
        default_use = {
            "host": "generic-host",
            "service": "generic-service",
            "contact": "generic-contact",
        }[args.object_type]

        fields = {
            "use": options.pop("use", default_use),
            "name": args.name,
            "register": options.pop("register", "0"),
        }
    elif resource == "hostgroup":
        fields = {"hostgroup_name": args.name, "alias": options.pop("alias", args.name)}
    elif resource == "servicegroup":
        fields = {"servicegroup_name": args.name, "alias": options.pop("alias", args.name)}
        if args.members:
            fields["members"] = args.members
        if args.servicegroup_members:
            fields["servicegroup_members"] = args.servicegroup_members
    elif resource == "contactgroup":
        fields = {"contactgroup_name": args.name, "alias": options.pop("alias", args.name)}
        if args.members:
            fields["members"] = args.members
        if args.contactgroup_members:
            fields["contactgroup_members"] = args.contactgroup_members
    elif resource == "command":
        fields = {"command_name": args.name}
    elif resource == "timeperiod":
        fields = {"timeperiod_name": args.name, "alias": options.pop("alias", args.name)}
    else:
        die(f"unsupported resource: {resource}")
    fields.update(options)
    return fields


# Replace one existing parsed object block with a newly rendered field map. The
# source offsets captured during parsing ensure unrelated object blocks and file
# content remain unchanged.
def update_object(obj: NagiosObject, fields: Dict[str, str], force: bool) -> None:
    """Update directives on an existing custom object."""
    if not object_is_custom(obj):
        die(f"refusing to modify Ansible/default-owned object in {obj.path}")
    text = read_text(obj.path)
    parsed_objects = parse_objects_from_text(text, obj.path)
    target = None
    for candidate in parsed_objects:
        if candidate.start == obj.start and candidate.end == obj.end:
            target = candidate
            break
    if target is None:
        die(f"could not locate object block in {obj.path}")
    updated_fields = dict(target.fields)
    updated_fields.update(fields)
    new_block = object_block(target.object_type, updated_fields).rstrip()
    new_text = text[:target.start] + new_block + text[target.end:]
    write_text_atomic(obj.path, new_text.strip() + "\n", force=force)


# Remove exactly one parsed object block from its source file. When no meaningful
# content remains, the custom file itself can be removed; otherwise surrounding
# objects/content are preserved.
def remove_object(obj: NagiosObject, force: bool) -> None:
    """Remove a custom object without validating or reloading Nagios."""
    if not object_is_custom(obj):
        die(f"refusing to remove Ansible/default-owned object in {obj.path}")
    confirm(f"Remove object from {obj.path}?", force=force)
    original_text = read_text(obj.path)
    original_stat = obj.path.stat()
    uid, gid = managed_identity()
    if (
            os.geteuid() != 0
            and (original_stat.st_uid != uid or original_stat.st_gid != gid)
    ):
        raise PermissionError(
            f"cannot safely remove from {obj.path} while preserving rollback metadata; "
            "run nagios-cmd as root"
        )
    new_text = (original_text[:obj.start] + original_text[obj.end:]).strip()
    if new_text:
        write_text_atomic(obj.path, new_text + "\n", force=True)
        return
    obj.path.unlink()


# Render a service definition template for a concrete host by substituting the
# hostname marker while leaving other variable placeholders for the dedicated
# variable-rendering stage.
def render_template(text: str, variables: Dict[str, str]) -> str:
    """Replace {{ key }} placeholders using Nagios object field variables."""

    def replace(match: re.Match) -> str:
        key = match.group(1).strip()
        return variables.get(key, match.group(0))

    return re.sub(r"\{\{\s*([A-Za-z0-9_]+)\s*\}\}", replace, text)


# Convert a validated service template name into its managed .tpl path. Name
# validation occurs before path construction to keep template access within the
# configured service-definition directory.
def service_template_path(name: str) -> Path:
    """Return the path for a service definition template by name."""
    return SERVICEDEFS_DIR / f"{safe_name(name, 'service definition')}.tpl"


# Implement generic object creation. The command builds and validates directive
# fields, determines the managed destination, confirms overwrite behavior when
# needed, and writes the resulting Nagios object atomically.
def cmd_generic_add(args: argparse.Namespace) -> int:
    """Add host, hostgroup, servicegroup, contact, contactgroup, command, template, or timeperiod."""
    ensure_layout()
    resource = args.resource
    name = safe_name(args.name, resource)
    existing = find_object(resource, name)
    if existing:
        confirm(f"{resource} {name} already exists in {existing.path}. Continue?", force=args.force)
    if resource == "host":
        ensure_hostgroup_file(args.hostgroup or DEFAULT_HOSTGROUP, force=True)
    object_type = args.object_type if resource == "template" else RESOURCE_META[resource]["object_type"]
    target = custom_object_path(resource, name, getattr(args, "hostgroup", None))
    fields = fields_for_add(resource, args)
    write_text_atomic(target, object_block(object_type, fields), force=args.force)
    print(f"Path: {target}")
    return 0


# List discovered objects for a generic resource. Existing human-readable text is
# the default and remains unchanged; --format json emits the same discovered data
# as structured JSON for automation such as the NetBox reconciliation process.
def cmd_generic_list(args: argparse.Namespace) -> int:
    """List objects for a resource in text or JSON format."""
    output_format = getattr(args, "format", "text")
    rows = []

    for obj in iter_objects(args.resource):
        name = object_name(args.resource, obj)
        if name:
            rows.append((name, obj.path, obj))

    if output_format == "json":
        objects = [
            {
                "name": name,
                "path": str(path),
                "object_type": obj.object_type,
                "fields": dict(obj.fields),
            }
            for name, path, obj in sorted(rows, key=lambda row: (row[0], str(row[1])))
        ]
        print(json.dumps(objects, indent=2, sort_keys=True))
        return 0

    # Preserve the existing text output exactly.
    if not rows:
        print(f"No {args.resource} objects found.")
        return 0

    name_width = max(
        len("NAME"),
        max(len(name) for name, _path, _obj in rows),
    )

    print(f"{'NAME':<{name_width}}  FILE")
    print(f"{'-' * name_width}  {'-' * 40}")

    for name, path, _obj in sorted(rows, key=lambda row: (row[0], str(row[1]))):
        print(f"{name:<{name_width}}  {path}")

    return 0


# Show either all objects or one named generic object. Text output follows the
# original code path exactly, while --format json exposes the already-parsed
# object metadata and directives without changing discovery or mutation logic.
def cmd_generic_show(args: argparse.Namespace) -> int:
    """Show one object in text or JSON format, or list objects if no name is given."""
    # A show request without a name historically behaves like list. Forward the
    # same Namespace so the selected output format is honored consistently.
    if not args.name:
        return cmd_generic_list(args)

    obj = find_object(args.resource, args.name)
    if obj is None:
        die(f"{args.resource} not found: {args.name}")

    # JSON is an opt-in read-only presentation path. It serializes data that was
    # already parsed by find_object() and does not alter the underlying object.
    if getattr(args, "format", "text") == "json":
        print(
            json.dumps(
                {
                    "name": object_name(args.resource, obj),
                    "path": str(obj.path),
                    "object_type": obj.object_type,
                    "fields": dict(obj.fields),
                },
                indent=2,
                sort_keys=True,
            )
        )
        return 0

    # Preserve the established text output exactly for backward compatibility.
    print(f"Path: {obj.path}\n")
    print(obj.raw.rstrip())
    return 0


# Return directive values from one existing object. With a key, print only that
# directive value; without a key, emit the complete field mapping in the command's
# established key=value representation.
def cmd_generic_get(args: argparse.Namespace) -> int:
    """Print one directive or all parsed directives for an object."""
    obj = find_object(args.resource, args.name)
    if obj is None:
        die(f"{args.resource} not found: {args.name}")
    if args.key:
        print(obj.fields.get(args.key, ""))
    else:
        for key, value in obj.fields.items():
            print(f"{key}={value}")
    return 0


# Modify directives on one custom-managed generic object. The operation refuses to
# edit default/Ansible-owned objects, merges requested changes, and uses the same
# atomic update mechanism as other mutations.
def cmd_generic_set(args: argparse.Namespace) -> int:
    """Set directives on an existing custom object."""
    obj = find_object(args.resource, args.name)
    if obj is None:
        die(f"{args.resource} not found: {args.name}")
    fields = parse_options(args.options)

    validation_resource = args.resource
    if args.resource == "template":
        validation_resource = obj.object_type

    validate_options(validation_resource, fields)

    if args.resource == "host":
        if args.address:
            fields["address"] = args.address
        if args.hostgroup:
            fields["hostgroups"] = args.hostgroup
            ensure_hostgroup_file(args.hostgroup, force=True)
    if args.resource == "servicegroup":
        if args.members:
            fields["members"] = args.members
        if args.servicegroup_members:
            fields["servicegroup_members"] = args.servicegroup_members
    if args.resource == "contactgroup":
        if args.members:
            fields["members"] = args.members
        if args.contactgroup_members:
            fields["contactgroup_members"] = args.contactgroup_members
    if not fields:
        die("nothing to set; use -o key=value or a resource-specific option")
    update_object(obj, fields, force=args.force)
    print(f"updated {args.resource}: {args.name}")
    return 0


# Remove one custom-managed generic object after the normal confirmation policy.
# Objects found only in default/Ansible-owned files remain protected from deletion.
def cmd_generic_remove(args: argparse.Namespace) -> int:
    """Remove a custom object by name."""
    obj = find_object(args.resource, args.name)
    if obj is None:
        die(f"{args.resource} not found: {args.name}")
    remove_object(obj, force=args.force)
    print(f"removed {args.resource}: {args.name}")
    return 0


# Show/list service templates or configured service objects. For the list action,
# text remains the default for backward compatibility and --format json provides a
# machine-readable representation without changing service discovery semantics.
def cmd_service_list(args: argparse.Namespace) -> int:
    """List service templates or configured services in text or JSON format."""
    ensure_layout()
    output_format = getattr(args, "format", "text")

    if args.name and not args.service_description:
        tpl = service_template_path(args.name)
        if tpl.exists():
            # Preserve existing show/text behavior when a template name is supplied.
            if output_format == "json":
                print(
                    json.dumps(
                        {
                            "name": args.name,
                            "path": str(tpl),
                            "type": "service_template",
                        },
                        indent=2,
                        sort_keys=True,
                    )
                )
            else:
                print(f"Path: {tpl}\n")
                print(read_text(tpl).rstrip())
            return 0

        rows = []
        for obj in iter_objects("service"):
            if obj.fields.get("host_name") == args.name:
                rows.append(
                    (
                        obj.fields.get("service_description", ""),
                        obj.path,
                        obj,
                    )
                )

        if rows:
            if output_format == "json":
                services = [
                    {
                        "host_name": args.name,
                        "service_description": service_description,
                        "path": str(path),
                        "object_type": obj.object_type,
                        "fields": dict(obj.fields),
                    }
                    for service_description, path, obj in sorted(
                        rows, key=lambda row: (row[0], str(row[1]))
                    )
                ]
                print(json.dumps(services, indent=2, sort_keys=True))
                return 0

            # Preserve the existing text output exactly.
            name_width = max(
                len("NAME"),
                max(len(service_description) for service_description, _path, _obj in rows),
            )

            print(f"{'NAME':<{name_width}}  FILE")
            print(f"{'-' * name_width}  {'-' * 40}")

            for service_description, path, _obj in sorted(
                    rows, key=lambda row: (row[0], str(row[1]))
            ):
                print(f"{service_description:<{name_width}}  {path}")

            return 0

        die(f"no service template or host services found for: {args.name}")

    if args.name and args.service_description:
        obj = find_object("service", args.name, args.service_description)
        if obj is None:
            die(f"service not found: {args.name}/{args.service_description}")

        if output_format == "json":
            print(
                json.dumps(
                    {
                        "host_name": args.name,
                        "service_description": args.service_description,
                        "path": str(obj.path),
                        "object_type": obj.object_type,
                        "fields": dict(obj.fields),
                    },
                    indent=2,
                    sort_keys=True,
                )
            )
        else:
            print(f"Path: {obj.path}\n")
            print(obj.raw.rstrip())
        return 0

    templates = sorted(SERVICEDEFS_DIR.glob("*.tpl"))

    if output_format == "json":
        print(
            json.dumps(
                [
                    {
                        "name": path.stem,
                        "path": str(path),
                    }
                    for path in templates
                ],
                indent=2,
                sort_keys=True,
            )
        )
        return 0

    # Preserve the existing text output exactly.
    if not templates:
        print("No service definition templates found.")
        return 0

    rows = [(path.stem, path) for path in templates]

    name_width = max(
        len("NAME"),
        max(len(name) for name, _path in rows),
    )

    print(f"{'NAME':<{name_width}}  FILE")
    print(f"{'-' * name_width}  {'-' * 40}")

    for name, path in rows:
        print(f"{name:<{name_width}}  {path}")

    return 0


# Instantiate one or more named service templates for a host. The command performs
# template substitution, validates required variables, detects collisions, and
# writes the resulting service definitions through the existing managed path.
def cmd_service_add(args: argparse.Namespace) -> int:
    """Render service definition templates and append them to a host config file."""
    ensure_layout()

    hostname = safe_name(args.hostname, "hostname")
    host_obj = find_object("host", hostname)
    if host_obj is None:
        die(f"host not found: {hostname}")

    hostgroup = (
            host_obj.fields.get("hostgroups", DEFAULT_HOSTGROUP).split(",", 1)[0]
            or DEFAULT_HOSTGROUP
    )
    target = custom_object_path("host", hostname, hostgroup)
    if not target.exists():
        die(f"host config file not found: {target}")

    services = [
        safe_name(service.strip(), "service definition")
        for service in args.services.split(",")
        if service.strip()
    ]
    if not services:
        die("no services specified")

    # Start with host properties so service templates can reference values
    # such as {{ host_name }}, {{ address }}, or other host directives.
    variables = dict(host_obj.fields)
    variables.setdefault("host_name", hostname)

    # Explicit -v/--variable values override host-derived variables. This
    # allows arbitrary template variables without adding them as Nagios
    # object directives.
    variables.update(parse_variables(args.variables))

    additions = []

    for service_name in services:
        tpl = service_template_path(service_name)
        if not tpl.exists():
            die(f"service definition template not found: {tpl}")

        template_vars = dict(variables)
        template_vars.setdefault("service_description", service_name)

        rendered = render_template(
            read_text(tpl),
            template_vars,
        ).rstrip()

        # Fail before writing if the template still contains unresolved
        # variables. This prevents invalid {{ variable }} placeholders from
        # being written into the Nagios configuration.
        validate_template_variables(rendered)

        for obj in parse_objects_from_text(rendered, tpl):
            if obj.object_type != "service":
                continue

            description = obj.fields.get(
                "service_description",
                service_name,
            )
            existing = find_object(
                "service",
                hostname,
                description,
            )
            if existing is not None:
                confirm(
                    (
                        f"service {hostname}/{description} already exists "
                        f"in {existing.path}. Continue?"
                    ),
                    force=args.force,
                )

        additions.append(
            "\n"
            f"# BEGIN nagios-cmd service {service_name}\n"
            f"{rendered}\n"
            f"# END nagios-cmd service {service_name}\n"
        )

    new_content = read_text(target).rstrip() + "\n" + "".join(additions)

    write_text_atomic(
        target,
        new_content,
        force=args.force,
    )

    print(f"added services to {hostname}: {', '.join(services)}")
    return 0


# Remove one or more configured services from a host. Comma-separated service
# descriptions are resolved individually and each matched custom object follows the
# existing confirmation/ownership safeguards.
def cmd_service_remove(args: argparse.Namespace) -> int:
    """Remove one or more service objects from a host by service_description."""
    hostname = safe_name(args.hostname, "hostname")
    service_descriptions = [s.strip() for s in args.service_description.split(",") if s.strip()]
    if not service_descriptions:
        die("no service descriptions specified")
    for service_description in service_descriptions:
        obj = find_object("service", hostname, service_description)
        if obj is None:
            die(f"service not found: {hostname}/{service_description}")
        remove_object(obj, force=args.force)
    print(f"removed services from {hostname}: {', '.join(service_descriptions)}")
    return 0


# Read service directive values using the host plus service description as the
# composite identity. Output behavior mirrors generic get while preserving the
# service-specific lookup semantics.
def cmd_service_get(args: argparse.Namespace) -> int:
    """Print one directive or all directives for a configured service object."""
    obj = find_object("service", args.hostname, args.service_description)
    if obj is None:
        die(f"service not found: {args.hostname}/{args.service_description}")
    if args.key:
        print(obj.fields.get(args.key, ""))
    else:
        for key, value in obj.fields.items():
            print(f"{key}={value}")
    return 0


# Update directives on one existing custom-managed service definition. Options are
# validated against service directives before the selected object block is replaced
# atomically.
def cmd_service_set(args: argparse.Namespace) -> int:
    """Set directives on an existing custom service object."""
    obj = find_object("service", args.hostname, args.service_description)
    if obj is None:
        die(f"service not found: {args.hostname}/{args.service_description}")
    fields = parse_options(args.options)
    validate_options("service", fields)
    if not fields:
        die("nothing to set; use -o key=value")
    update_object(obj, fields, force=args.force)
    print(f"updated service: {args.hostname}/{args.service_description}")
    return 0


# Run a full Nagios configuration validation and print the verifier output. This is
# read-only and returns Nagios's validation status directly to the invoking shell.
def cmd_config_check(args: argparse.Namespace) -> int:
    """Validate the active Nagios configuration."""
    try:
        validate_config()
    except NagiosCmdError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    print("Nagios configuration OK")
    return 0


# Print every configuration file path currently considered by nagios-cmd. This is
# an inventory/debugging utility and intentionally does not alter configuration.
# JSON mode returns the same discovered paths as an array; text mode is unchanged.
def cmd_config_list(args: argparse.Namespace) -> int:
    """List discovered configuration file paths in text or JSON format."""
    # Materialize once so both output modes operate on the exact same discovery
    # result and no configuration traversal semantics are changed.
    paths = list(iter_cfg_files())

    if getattr(args, "format", "text") == "json":
        print(json.dumps([str(path) for path in paths], indent=2, sort_keys=True))
        return 0

    # Preserve the original text loop and one-path-per-line representation.
    for path in paths:
        print(path)
    return 0


# Concatenate and print the discovered Nagios configuration files for inspection.
# File boundaries are retained in the established output so operators can identify
# the source of each block.
def cmd_config_dump(args: argparse.Namespace) -> int:
    """Dump concatenated configuration to stdout with path markers."""
    first = True
    for path in iter_cfg_files():
        if not first:
            print()
        first = False
        print(f"# BEGIN {path}")
        print(read_text(path).rstrip())
        print(f"# END {path}")
    return 0


# Create a timestamped gzip-compressed tar archive of the Nagios configuration tree.
# The destination can be overridden by the caller while preserving the configured
# default backup directory.
def cmd_config_backup(args: argparse.Namespace) -> int:
    """Create a tar.gz backup of nagios.cfg, objects/, and servicedefs/."""
    destination_dir = Path(args.directory).expanduser() if args.directory else BACKUP_DIR
    destination_dir.mkdir(parents=True, exist_ok=True)
    timestamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    backup_path = destination_dir / f"nagios-config-backup-{timestamp}.tar.gz"
    with tarfile.open(backup_path, "w:gz") as archive:
        for path in [NAGIOS_CFG, OBJECTS_DIR, SERVICEDEFS_DIR]:
            if path.exists():
                archive.add(path, arcname=str(path.relative_to("/")))
    print(backup_path)
    return 0


# Validate the entire Nagios configuration first, then reload the configured systemd
# service only when validation succeeds. This preserves the safety boundary between
# file mutation and activation.
def cmd_config_reload(args: argparse.Namespace) -> int:
    """Validate configuration and reload the Nagios systemd service."""
    check_result = cmd_config_check(args)
    if check_result != 0:
        return check_result
    result = run_command(["systemctl", "reload", NAGIOS_SERVICE])
    if result.returncode != 0:
        die(result.stdout.rstrip() or f"failed to reload {NAGIOS_SERVICE}")
    print(f"reloaded {NAGIOS_SERVICE}")
    return 0


# Add the common output selector used by all read-only show/list commands. Keeping
# this definition centralized guarantees the same choices and default everywhere.
# Text remains the default so existing users and Molecule assertions continue to
# receive the historical human-readable output unless JSON is explicitly requested.
def add_format_argument(parser: argparse.ArgumentParser) -> None:
    """Add the shared --format {text,json} option to a read-only parser."""
    parser.add_argument(
        "--format",
        choices=("text", "json"),
        default="text",
        help="Output format. Default: text",
    )


# Register argparse subcommands shared by generic Nagios resource types. Both show
# and list gain the read-only --format selector; all add/set/remove/get arguments
# and handlers remain unchanged so configuration manipulation semantics are intact.
def add_generic_resource_parser(subparsers: argparse._SubParsersAction, resource: str) -> None:
    """Register add/remove/show/list/set/get argparse actions for a generic resource."""
    parser = subparsers.add_parser(
        resource,
        help=f"Manage {resource} objects",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=format_object_directives(resource),
    )
    actions = parser.add_subparsers(dest="action", required=True)
    add_parser = actions.add_parser(
        "add",
        help=f"Add {resource}",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=format_object_directives(resource),
    )
    add_parser.add_argument("name")
    if resource == "host":
        add_parser.add_argument("address")
        add_parser.add_argument("-g", "--hostgroup", default=DEFAULT_HOSTGROUP)
    if resource == "template":
        add_parser.add_argument("-t", "--object-type", choices=["host", "service", "contact"], default="host", help="Nagios object type for this template")
    if resource == "servicegroup":
        add_parser.add_argument("-m", "--members", help="Servicegroup members as host,service,host,service")
        add_parser.add_argument("--servicegroup-members", help="Comma-separated nested servicegroup members")
    if resource == "contactgroup":
        add_parser.add_argument("-m", "--members", help="Comma-separated contact members")
        add_parser.add_argument("-g", "--contactgroup-members", help="Comma-separated nested contactgroup members")
    add_parser.add_argument("-o", "--options", action="append", help="Nagios directive(s): key=value or key=value,key=value")
    add_parser.add_argument("-f", "--force", action="store_true", help="Do not prompt before overwrite")
    add_parser.set_defaults(func=cmd_generic_add, resource=resource)
    for alias in ("show", "list"):
        show_parser = actions.add_parser(alias, help=f"{alias.capitalize()} {resource} objects")
        show_parser.add_argument("name", nargs="?")
        # --format affects presentation only. The default text mode preserves the
        # command's pre-existing output and therefore remains backward compatible.
        add_format_argument(show_parser)
        show_parser.set_defaults(func=cmd_generic_show if alias == "show" else cmd_generic_list, resource=resource)
    get_parser = actions.add_parser("get", help=f"Get {resource} directive values")
    get_parser.add_argument("name")
    get_parser.add_argument("key", nargs="?")
    get_parser.set_defaults(func=cmd_generic_get, resource=resource)
    set_parser = actions.add_parser("set", help=f"Set {resource} directive values")
    set_parser.add_argument("name")
    if resource == "host":
        set_parser.add_argument("address", nargs="?")
        set_parser.add_argument("-g", "--hostgroup")
    if resource == "servicegroup":
        set_parser.add_argument("-m", "--members", help="Servicegroup members as host,service,host,service")
        set_parser.add_argument("--servicegroup-members", help="Comma-separated nested servicegroup members")
    if resource == "contactgroup":
        set_parser.add_argument("-m", "--members", help="Comma-separated contact members")
        set_parser.add_argument("--contactgroup-members", help="Comma-separated nested contactgroup members")
    set_parser.add_argument("-o", "--options", action="append", help="Nagios directive(s): key=value or key=value,key=value")
    set_parser.add_argument("-f", "--force", action="store_true", help="Do not prompt before overwrite")
    set_parser.set_defaults(func=cmd_generic_set, resource=resource)
    remove_parser = actions.add_parser("remove", help=f"Remove {resource}")
    remove_parser.add_argument("name")
    remove_parser.add_argument("-f", "--force", action="store_true", help="Do not prompt before removal")
    remove_parser.set_defaults(func=cmd_generic_remove, resource=resource)


# Register service-specific argparse actions. Service show and list receive the same
# optional --format selector; add/remove/get/set argument shapes and handlers remain
# unchanged to preserve all existing configuration mutation behavior.
def add_service_parser(subparsers: argparse._SubParsersAction) -> None:
    """Register service-specific argparse actions."""
    parser = subparsers.add_parser(
        "service",
        help="Manage services and service definition templates",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=format_object_directives("service"),
    )
    actions = parser.add_subparsers(dest="action", required=True)
    for alias in ("show", "list"):
        show_parser = actions.add_parser(alias, help="Show/list service templates or configured services")
        show_parser.add_argument("name", nargs="?")
        show_parser.add_argument("service_description", nargs="?")
        # The same handler serves show and list. Supplying --format json only
        # changes serialization; text remains the default historical behavior.
        add_format_argument(show_parser)
        show_parser.set_defaults(func=cmd_service_list)
    add_parser = actions.add_parser("add", help="Add service template(s) to a host")
    add_parser.add_argument("hostname")
    add_parser.add_argument("-s", "--services", required=True, help="Comma-separated service definition template names")
    add_parser.add_argument("-f", "--force", action="store_true", help="Do not prompt before overwrite")
    add_parser.add_argument("-v", "--variable", dest="variables", action="append", default=[], metavar="NAME=VALUE",
                            help="Set a service template variable; may be specified multiple times.",
                            )
    add_parser.set_defaults(func=cmd_service_add)
    remove_parser = actions.add_parser("remove", help="Remove service object(s) from a host")
    remove_parser.add_argument("hostname")
    remove_parser.add_argument("service_description", help="Service description or comma-separated descriptions")
    remove_parser.add_argument("-f", "--force", action="store_true", help="Do not prompt before removal")
    remove_parser.set_defaults(func=cmd_service_remove)
    get_parser = actions.add_parser("get", help="Get service directive values")
    get_parser.add_argument("hostname")
    get_parser.add_argument("service_description")
    get_parser.add_argument("key", nargs="?")
    get_parser.set_defaults(func=cmd_service_get)
    set_parser = actions.add_parser("set", help="Set service directive values")
    set_parser.add_argument("hostname")
    set_parser.add_argument("service_description")
    set_parser.add_argument("-o", "--options", action="append", required=True, help="Nagios directive(s): key=value or key=value,key=value")
    set_parser.add_argument("-f", "--force", action="store_true", help="Do not prompt before overwrite")
    set_parser.set_defaults(func=cmd_service_set)


# Register read/validation/backup/reload configuration utility subcommands. No output
# format switch is added here because the requested feature applies only to object
# list operations.
def add_config_parser(subparsers: argparse._SubParsersAction) -> None:
    """Register config utility argparse actions."""
    parser = subparsers.add_parser("config", help="Configuration utilities")
    actions = parser.add_subparsers(dest="action", required=True)
    check_parser = actions.add_parser("check", help="Run Nagios validation")
    check_parser.set_defaults(func=cmd_config_check)
    list_parser = actions.add_parser("list", help="List configuration file paths")
    # Config list is also a read-only list operation, so expose the same output
    # contract without changing its default text behavior.
    add_format_argument(list_parser)
    list_parser.set_defaults(func=cmd_config_list)
    dump_parser = actions.add_parser("dump", help="Dump concatenated configuration")
    dump_parser.set_defaults(func=cmd_config_dump)
    backup_parser = actions.add_parser("backup", help="Create tar.gz backup")
    backup_parser.add_argument("directory", nargs="?", help=f"Backup destination directory; default: {BACKUP_DIR}")
    backup_parser.set_defaults(func=cmd_config_backup)
    reload_parser = actions.add_parser("reload", help="Validate and reload Nagios")
    reload_parser.set_defaults(func=cmd_config_reload)


# Assemble the complete command-line interface, including top-level help, generic
# resources, services, and config utilities. Existing command names/arguments are
# preserved to maintain backward compatibility.
def build_parser() -> argparse.ArgumentParser:
    """Build the top-level CLI parser and subcommands."""
    parser = argparse.ArgumentParser(prog="nagios-cmd", description="""
        Manage custom Nagios configuration via command line options.

        Object reference values:
        https://assets.nagios.com/downloads/nagioscore/docs/nagioscore/4/en/objectdefinitions.html
    """,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    subparsers = parser.add_subparsers(dest="resource", required=True)
    help_parser = subparsers.add_parser(
        "help",
        help="Show top-level help or documented directives for an object type",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    help_parser.add_argument(
        "object_type",
        nargs="?",
        choices=[*OBJECT_DIRECTIVES.keys(), "template"],
        help="Nagios object type",
    )

    # Nested handler for the explicit `nagios-cmd help` command. With an object type it
    # prints directive documentation; without one it reuses the top-level argparse help.
    def show_help(args: argparse.Namespace) -> int:
        if args.object_type:
            print(format_object_directives(args.object_type))
            return 0
        parser.print_help()
        return 0

    help_parser.set_defaults(func=show_help)
    for resource in ["host", "hostgroup", "servicegroup", "contact", "contactgroup", "command", "template", "timeperiod"]:
        add_generic_resource_parser(subparsers, resource)
    add_service_parser(subparsers)
    add_config_parser(subparsers)
    return parser


# Parse arguments, dispatch to the selected command handler, and normalize expected
# operational exceptions into stable exit codes/messages. Unexpected programming
# errors are intentionally not swallowed by these user-facing exception handlers.
def main() -> int:
    """Program entry point; dispatch argparse commands and handle errors cleanly."""
    parser = build_parser()
    args = parser.parse_args()
    try:
        return args.func(args)
    except NagiosCmdError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    except PermissionError as exc:
        print(f"permission denied: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())